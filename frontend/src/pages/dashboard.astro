---
import Layout from '../layouts/Layout.astro';
---
<Layout title="OxigenNative IDE">
  <div id="app" style="display: flex; flex-direction: column; height: 100vh;">
    <header class="page-header">
      <h1>
        <img src="/logoOX.svg" alt="OxigenNative" style="height: 32px;" />
        OxigenNative IDE
      </h1>
      <div class="nav-links">
        <a href="/dashboard" class="active">Editor</a>
        <a href="/errores">Errores</a>
        <a href="/simbolos">Simbolos</a>
        <a href="/ast">AST</a>
        <button id="theme-toggle" class="theme-btn">Claro</button>
      </div>
    </header>

    <div style="flex:1; padding:16px; display:flex; flex-direction:column; gap:12px; overflow:hidden;">
      <div class="panel" style="padding:12px 16px;">
        <div style="display:flex; gap:8px; align-items:center; flex-wrap:wrap;">
          <button class="btn-primary" id="btn-new">Nuevo</button>
          <button class="btn-primary" id="btn-load">Cargar</button>
          <button class="btn-primary" id="btn-save">Guardar</button>
          <div style="width:1px; height:24px; background:var(--dark-border); margin:0 4px;"></div>
          <button class="btn-primary" id="btn-run" style="background:#22c55e;">Ejecutar</button>
        </div>
      </div>
      <div id="editor-container" class="panel" style="flex:1; padding:0; overflow:hidden;"></div>
    </div>

    <div id="console-panel" class="panel" style="margin:0 16px 16px 16px; padding:0; overflow:hidden;">
      <button id="console-toggle" style="width:100%; padding:8px; background:var(--purple-600); color:white; border:none; cursor:pointer; font-weight:600; font-size:13px; display:flex; align-items:center; justify-content:center; gap:8px; border-radius:0;">
        <span id="console-arrow">&#9650;</span> Consola <span id="console-badge"></span>
      </button>
      <div id="console-output" style="background:var(--dark-bg); border-top:1px solid var(--dark-border); padding:16px; max-height:250px; overflow-y:auto; font-family:'Fira Code',monospace; font-size:13px; line-height:1.6;">
        <p style="color:var(--dark-muted); font-style:italic;">Presiona "Ejecutar" para ver la salida...</p>
      </div>
    </div>
  </div>
  <input type="file" id="file-input" accept="*" style="display:none;" />
</Layout>

<style is:global>
  .cm-editor { height: 100%; }
  .cm-editor .cm-scroller { overflow: auto; }
  .theme-btn {
    background: var(--purple-500); color: white; border: none; border-radius: 0;
    padding: 6px 14px; cursor: pointer; font-size: 13px; font-weight: 600;
  }
</style>

<script>
import { EditorView, keymap, lineNumbers, highlightActiveLine, highlightActiveLineGutter } from '@codemirror/view';
import { EditorState } from '@codemirror/state';
import { defaultKeymap, history, historyKeymap } from '@codemirror/commands';
import { javascript } from '@codemirror/lang-javascript';
import { oneDark } from '@codemirror/theme-one-dark';
import { syntaxHighlighting, defaultHighlightStyle, bracketMatching, foldGutter, indentOnInput } from '@codemirror/language';
import { closeBrackets, closeBracketsKeymap } from '@codemirror/autocomplete';
import { highlightSelectionMatches, searchKeymap } from '@codemirror/search';

const lightTheme = EditorView.theme({
  '&': { backgroundColor: '#ffffff', color: '#1a1028' },
  '.cm-content': { caretColor: '#7c3aed', fontFamily: "'Fira Code',monospace", fontSize: '14px' },
  '.cm-cursor': { borderLeftColor: '#7c3aed' },
  '.cm-activeLine': { backgroundColor: '#f0eaf8' },
  '.cm-activeLineGutter': { backgroundColor: '#f0eaf8' },
  '.cm-gutters': { backgroundColor: '#f8f7fc', color: '#9580ab', border: 'none', borderRight: '1px solid #e0d8f0' },
  '.cm-selectionBackground': { backgroundColor: '#e0d0f5 !important' },
});

let editorView: EditorView | null = null;
let consoleVisible = false;

function getCode(): string {
  return editorView ? editorView.state.doc.toString() : localStorage.getItem('oxigen_code') || '';
}

function getIsDark(): boolean {
  return document.documentElement.classList.contains('dark');
}

function initEditor() {
  const container = document.getElementById('editor-container');
  if (!container) return;
  const saved = localStorage.getItem('oxigen_code') || 'fn main() {\n  println!("Hola OxigenNative!");\n}\n';
  const update = EditorView.updateListener.of(u => {
    if (u.docChanged) localStorage.setItem('oxigen_code', u.state.doc.toString());
  });
  editorView = new EditorView({
    state: EditorState.create({
      doc: saved,
      extensions: [
        lineNumbers(), highlightActiveLineGutter(), history(), foldGutter(),
        indentOnInput(), syntaxHighlighting(defaultHighlightStyle), bracketMatching(),
        closeBrackets(), highlightActiveLine(), highlightSelectionMatches(),
        keymap.of([...closeBracketsKeymap, ...defaultKeymap, ...searchKeymap, ...historyKeymap]),
        javascript(), update, EditorView.lineWrapping, getIsDark() ? oneDark : lightTheme,
      ],
    }),
    parent: container,
  });
}

function toggleConsole() {
  consoleVisible = !consoleVisible;
  const out = document.getElementById('console-output');
  const a = document.getElementById('console-arrow');
  if (out) out.style.display = consoleVisible ? 'block' : 'none';
  if (a) a.innerHTML = consoleVisible ? '&#9660;' : '&#9650;';
}

function updateConsole(output: string, errors: {line:number;col:number;message:string}[]) {
  const c = document.getElementById('console-output');
  const b = document.getElementById('console-badge');
  if (!c) return;
  if (output) {
    b!.innerHTML = errors.length > 0
      ? '<span style="background:#f59e0b;padding:2px 8px;font-size:11px;">' + errors.length + ' advertencia(s)</span>'
      : '<span style="background:#22c55e;padding:2px 8px;font-size:11px;">OK</span>';
    let html = '<pre style="color:#a3e635;white-space:pre-wrap;margin:0;">' + output + '</pre>';
    if (errors.length > 0) {
      html += '<div style="margin-top:12px;padding-top:8px;border-top:1px solid var(--dark-border);">';
      html += '<p style="color:#fbbf24;font-size:12px;font-weight:600;margin-bottom:4px;">Advertencias:</p>';
      html += errors.map(e => '<div style="color:#fbbf24;font-size:12px;">' + e.line + ':' + e.col + ' ' + e.message + '</div>').join('');
      html += '</div>';
    }
    c.innerHTML = html;
  } else if (errors.length > 0) {
    b!.innerHTML = '<span style="background:#ef4444;padding:2px 8px;font-size:11px;">' + errors.length + ' errores</span>';
    c.innerHTML = '<p style="color:#f87171;font-weight:600;">La ejecucion del programa no pudo llevarse a cabo, por favor vea la tabla de errores</p>' +
      errors.map(e => '<div style="color:#fbbf24;">' + e.line + ':' + e.col + ' ' + e.message + '</div>').join('');
  } else {
    b!.innerHTML = '';
    c.innerHTML = '<p style="color:var(--dark-muted);font-style:italic;">Sin salida</p>';
  }
}

async function runCode() {
  const code = getCode();
  if (!code.trim()) return;
  const btn = document.getElementById('btn-run')!;
  btn.textContent = 'Ejecutando...';
  btn.setAttribute('disabled', 'true');
  try {
    const res = await fetch('/api/compile', {
      method: 'POST', headers: { 'Content-Type': 'application/json' },
      body: JSON.stringify({ code }),
    });
    const data = await res.json();
    localStorage.setItem('oxigen_output', data.output || '');
    localStorage.setItem('oxigen_errors', JSON.stringify(data.errors || []));
    localStorage.setItem('oxigen_ast_image', data.ast_image || '');
    const tokRes = await fetch('/api/tokens', {
      method: 'POST', headers: { 'Content-Type': 'application/json' },
      body: JSON.stringify({ code }),
    });
    const tokData = await tokRes.json();
    localStorage.setItem('oxigen_tokens', JSON.stringify(tokData.tokens || []));
    updateConsole(data.output || '', data.errors || []);
    if (!consoleVisible) toggleConsole();
  } catch (err) {
    console.error('Error:', err);
  } finally {
    btn.removeAttribute('disabled');
    btn.textContent = 'Ejecutar';
  }
}

document.getElementById('btn-new')?.addEventListener('click', () => {
  localStorage.removeItem('oxigen_code');
  if (editorView) editorView.dispatch({ changes: { from: 0, to: editorView.state.doc.length, insert: '' } });
});
document.getElementById('btn-load')?.addEventListener('click', () => {
  document.getElementById('file-input')?.click();
});
document.getElementById('btn-save')?.addEventListener('click', () => {
  const code = getCode();
  const blob = new Blob([code], { type: 'text/plain' });
  const a = document.createElement('a');
  a.href = URL.createObjectURL(blob);
  a.download = 'programa.ox';
  a.click();
  URL.revokeObjectURL(a.href);
});
document.getElementById('btn-run')?.addEventListener('click', runCode);
document.getElementById('console-toggle')?.addEventListener('click', toggleConsole);
document.getElementById('file-input')?.addEventListener('change', (e: Event) => {
  const file = (e.target as HTMLInputElement).files?.[0];
  if (!file) return;
  const reader = new FileReader();
  reader.onload = () => { localStorage.setItem('oxigen_code', reader.result as string); location.reload(); };
  reader.readAsText(file);
  (e.target as HTMLInputElement).value = '';
});
document.getElementById('theme-toggle')?.addEventListener('click', () => {
  const next = !getIsDark();
  document.documentElement.classList.toggle('dark', next);
  localStorage.setItem('theme', next ? 'dark' : 'light');
  document.getElementById('theme-toggle')!.textContent = next ? 'Oscuro' : 'Claro';
});

initEditor();
</script>
