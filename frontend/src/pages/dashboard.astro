---
import Layout from '../layouts/Layout.astro';
import BarraHerramientas from '../components/BarraHerramientas.astro';
import PanelEditor from '../components/PanelEditor.astro';
import PanelArm64 from '../components/PanelArm64.astro';
import Consola from '../components/Consola.astro';
import PanelReportes from '../components/PanelReportes.astro';
import '../styles/ide.css';
---
<Layout title="OxigenNative IDE">
  <div class="ide">
    <BarraHerramientas />
    <div class="ide-fila">
      <PanelEditor />
      <PanelArm64 />
    </div>
    <div class="ide-fila inferior">
      <Consola />
      <PanelReportes />
    </div>
  </div>
</Layout>

<script>
  import '../scripts/main';
</script>
