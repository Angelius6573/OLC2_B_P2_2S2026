---
import Layout from '../layouts/Layout.astro';
---
<Layout title="Errores - OxigenScript IDE">
  <div style="display:flex; flex-direction:column; height:100vh;">
    <header class="page-header">
      <h1><img src="/logoOX.svg" alt="OxigenScript" style="height:32px;" /> OxigenScript IDE</h1>
      <div class="nav-links">
        <a href="/dashboard">Editor</a>
        <a href="/errores" class="active">Errores</a>
        <a href="/simbolos">Simbolos</a>
        <a href="/ast">AST</a>
        <button id="theme-toggle" class="theme-btn">Claro</button>
      </div>
    </header>
    <div style="flex:1; padding:24px; overflow-y:auto;">
      <div class="panel" style="max-width:900px; margin:0 auto;">
        <h2 style="margin-bottom:16px; font-size:18px; color:var(--purple-400);">Tabla de Errores</h2>
        <div id="error-table"></div>
      </div>
    </div>
  </div>
</Layout>

<style is:global>
  .theme-btn {
    background: var(--purple-500); color: white; border: none; border-radius: 0;
    padding: 6px 14px; cursor: pointer; font-size: 13px; font-weight: 600;
  }
</style>

<script>
function renderErrors() {
  const c = document.getElementById('error-table');
  if (!c) return;
  const errors = JSON.parse(localStorage.getItem('oxigen_errors') || '[]');
  if (errors.length === 0) {
    c.innerHTML = '<div style="text-align:center; padding:40px;"><p style="color:#22c55e; font-size:16px; font-weight:600;">Sin errores</p><p style="color:var(--dark-muted); margin-top:8px;">El programa compilo correctamente</p></div>';
    return;
  }
  const sorted = [...errors].sort((a: any, b: any) => a.line - b.line);
  const catColor: Record<string,string> = { Lexico:'#f59e0b', Sintactico:'#ef4444', Semantico:'#8b5cf6', Ejecucion:'#ec4899' };
  let html = '<table><thead><tr><th>#</th><th>Linea</th><th>Columna</th><th>Mensaje</th></tr></thead><tbody>';
  sorted.forEach((err: any, i: number) => {
    const cat = err.message.match(/\[(\w+)\]/)?.[1] || 'Error';
    const color = catColor[cat] || '#94a3b8';
    html += '<tr><td style="color:var(--dark-muted);">' + (i+1) + '</td><td style="font-weight:600;">' + err.line + '</td><td>' + err.col + '</td><td><span style="display:inline-block; background:' + color + '20; color:' + color + '; padding:2px 8px; font-size:12px; font-weight:600; margin-right:8px;">' + cat + '</span>' + err.message.replace(/\[\w+\]\s*/, '') + '</td></tr>';
  });
  c.innerHTML = html + '</tbody></table>';
}
renderErrors();
document.getElementById('theme-toggle')?.addEventListener('click', () => {
  const d = document.documentElement; d.classList.toggle('dark');
  localStorage.setItem('theme', d.classList.contains('dark') ? 'dark' : 'light');
  document.getElementById('theme-toggle')!.textContent = d.classList.contains('dark') ? 'Oscuro' : 'Claro';
});
</script>
