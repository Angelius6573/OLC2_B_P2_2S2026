// Flujo de la tabla de símbolos: del checker al reporte HTML
digraph flujo_tabla_simbolos {
  graph [rankdir=TB, fontname="Helvetica", fontsize=12, nodesep=0.4, ranksep=0.4, bgcolor="white"];
  node  [fontname="Helvetica", fontsize=10, shape=box, style="rounded,filled", fillcolor="#f3eefc", color="#6d28d9"];
  edge  [fontname="Helvetica", fontsize=9, color="#4c1d95"];

  ast [label="AST (Programa)", shape=oval, fillcolor="#ede9fe"];
  colectar [label="colectar_declaraciones\ndeclarar_funcion / declarar_struct\n(antes de visitar cuerpos: se permiten\nllamadas a funciones declaradas después)"];
  funcion [label="visitar_DeclaracionFuncion\nabrir_ambito · ambito_nombre = función\nparámetros → SimboloVariable(categoria='Parámetro')"];
  decl [label="visitar_DeclaracionVariable\nSimboloVariable(nombre, tipo, mutable, línea)\ndeclarar_variable → sym_id nuevo (contador)"];
  uso [label="visitar_Variable / Asignacion\nbuscar_variable recorre los ámbitos\nde adentro hacia afuera (shadowing)"];
  anot [label="nodo.sym_id = simbolo.sym_id\nnodo.tipo = tipo del símbolo"];
  err [label="error semántico\n(no declarada, inmutable, tipos)", fillcolor="#fee2e2", color="#b91c1c"];
  cerrar [label="cerrar_ambito\n(el historial conserva el símbolo)"];
  gen [label="GeneradorARM64\nsimbolo.offset = slot en el marco\n[x29, #offset]"];
  valores [label="InterpreteConValores\ncelda por sym_id con el último valor"];
  reporte [label="TablaSimbolos.reporte()\nNo · Identificador · Categoría · Tipo · Ámbito · Línea"];
  filas [label="filas_simbolos(tabla, celdas)\ncolumna «Valor»: último valor\no valor por defecto del tipo"];
  html [label="escribir_reporte → HTML\nbuild/reportes/simbolos_<ms>.html"];
  gui [label="Pestaña Símbolos y\n«Reporte HTML de símbolos»", shape=oval, fillcolor="#ede9fe"];

  ast -> colectar -> funcion -> decl;
  funcion -> uso;
  decl -> anot;
  uso -> anot [label="encontrado"];
  uso -> err [label="no encontrado\no inmutable"];
  anot -> cerrar;
  cerrar -> gen [label="modo ARM64"];
  cerrar -> valores [label="ejecución"];
  cerrar -> reporte;
  reporte -> filas;
  valores -> filas;
  filas -> html -> gui;
}
